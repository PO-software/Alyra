# Copiez ce fichier en .env.local pour le développement.

# --- Réseau local (nœud Hardhat, chain id 31337) ---
# Rempli automatiquement par `pnpm sync:local` après `pnpm deploy:local` dans backend/.
NEXT_PUBLIC_VOTING_ADDRESS_HARDHAT=
NEXT_PUBLIC_DEPLOYMENT_BLOCK_HARDHAT=0

# --- Sepolia (chain id 11155111) ---
# Adresse du contrat Voting déployé et bloc de déploiement (point de départ de la lecture des événements).
NEXT_PUBLIC_VOTING_ADDRESS_SEPOLIA=
NEXT_PUBLIC_DEPLOYMENT_BLOCK_SEPOLIA=

# URL Infura complète, clé comprise. CÔTÉ SERVEUR UNIQUEMENT : ne jamais la préfixer par NEXT_PUBLIC_.
# Utilisée par la route /api/rpc ; le navigateur ne la voit jamais.
SEPOLIA_RPC_URL=

# Développement uniquement : affiche les comptes de test Hardhat pour changer de compte sans MetaMask.
NEXT_PUBLIC_DEV_WALLETS=false
